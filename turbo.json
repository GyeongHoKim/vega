{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vitepress/dist/**", "api/**"]
    },
    "lint": {},
    "format": {},
    "format:check": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "release": {
      "dependsOn": ["build", "test"],
      "cache": false
    }
  }
}

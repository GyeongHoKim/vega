{
	"buildCommand": "cd ../.. && pnpm exec turbo run build --filter=@gyeonghokim/vega-doc",
	"outputDirectory": ".vitepress/dist",
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}

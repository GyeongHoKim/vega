{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "extends": ["./library.json"],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/.vitepress/dist",
      "!**/.vitepress/cache",
      "!**/api"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.md"],
      "formatter": {
        "lineWidth": 100
      }
    }
  ]
}
